// FileDrop database schema
// A "Drop" is one share event (one shareable link) and can contain one or
// more files. This lets the core single-file flow and the "multiple files
// per link" nice-to-have share the same model without duplication.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DropStatus {
  PENDING // created, waiting for file bytes to finish uploading
  ACTIVE // available for download
  EXPIRED // past expiresAt, or download/burn limit reached
  DELETED // storage objects removed by cleanup job
}

model Drop {
  id String @id @default(cuid())

  /// Public, unguessable identifier used in share URLs (/f/{shareId}).
  /// Never expose the internal `id` or storage keys to clients.
  shareId String @unique

  /// Capability token shown to the uploader once, at creation time —
  /// proves "I'm the one who made this" well enough to let them delete it
  /// early (see DELETE /api/share/[shareId]), without needing accounts.
  /// Plaintext by design: it's a random, high-entropy secret like
  /// shareId, not a reusable password — nothing meaningful is gained by
  /// hashing it, and a plaintext compare stays constant-time at the
  /// call site instead.
  deleteToken String @unique

  /// Optional bcrypt hash. Never store the plaintext password.
  passwordHash String?

  /// null = unlimited downloads. Otherwise the drop becomes unavailable
  /// once downloadCount reaches maxDownloads.
  maxDownloads Int?

  /// Number of times a file in this drop has been successfully downloaded.
  /// Mutated only via a single atomic UPDATE so concurrent requests can't
  /// race past the configured limit.
  downloadCount Int @default(0)

  /// When true, the drop is marked EXPIRED as soon as the first download
  /// completes, regardless of maxDownloads.
  burnAfterRead Boolean @default(false)

  status DropStatus @default(PENDING)

  createdAt DateTime @default(now())
  expiresAt DateTime

  /// IP hash / user agent are intentionally NOT stored to keep uploads
  /// anonymous. Only what's required for rate limiting is kept, and that
  /// lives in memory, not the database.
  files UploadFile[]

  @@index([shareId])
  @@index([expiresAt])
  @@index([status])
}

model UploadFile {
  id     String @id @default(cuid())
  dropId String
  drop   Drop   @relation(fields: [dropId], references: [id], onDelete: Cascade)

  originalFileName String
  sanitizedFileName String

  /// Object storage key. Never exposed to clients.
  storageKey String

  /// Server-verified MIME type (sniffed from file bytes, not trusted from
  /// the browser-supplied Content-Type).
  mimeType String

  /// Size in bytes, verified server-side against the bytes actually
  /// received and written to storage.
  size BigInt

  status DropStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([dropId])
  @@index([storageKey])
}

enum P2pStatus {
  WAITING // link created, no peer has connected yet
  CONNECTED // both sender and receiver are present in the signaling room
  COMPLETED // receiver reported the transfer finished
  EXPIRED // past expiresAt, or the room was closed
}

/// A direct browser-to-browser transfer: the file itself is never uploaded
/// to or stored by the server — only this small metadata row exists here,
/// and the signaling server (see src/lib/p2p/signalingServer.ts) relays
/// the WebRTC handshake between the two browsers in memory. There is no
/// object-storage cleanup for these, unlike Drop/UploadFile.
model P2pTransfer {
  id String @id @default(cuid())

  /// Public, unguessable identifier used in share URLs (/p2p/{shareId})
  /// and as the signaling room key.
  shareId String @unique

  /// Declared by the sender at link-creation time, before any peer has
  /// connected — sanitized the same way as server-stored file names.
  fileName String
  fileSize BigInt
  mimeType String

  /// Optional bcrypt hash, gating the signaling handshake itself (a
  /// receiver can't exchange SDP/ICE with the sender without it) — never
  /// stored in plaintext.
  passwordHash String?

  status P2pStatus @default(WAITING)

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([shareId])
  @@index([expiresAt])
  @@index([status])
}
