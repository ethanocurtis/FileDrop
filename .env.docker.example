# Copy this file to .env.docker, then run compose with:
#   docker compose --env-file .env.docker up -d --build
# (a distinct file/flag on purpose, so it never collides with the plain
# .env you'd use for `npm run dev` in the same checkout.)
#
# This is a DIFFERENT set of variables than .env.example — that one is for
# running the app directly; this one only supplies the values
# docker-compose.yml substitutes into the containers it builds (which set
# DATABASE_URL/S3_* themselves, wired to the `postgres`/`minio` service
# names — see docker-compose.yml).

# --- Postgres (used by the postgres container + assembled into DATABASE_URL) ---
POSTGRES_USER=filedrop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=filedrop

# --- MinIO (used by the minio container + assembled into S3_* for the app) ---
MINIO_ROOT_USER=filedrop
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# --- Secrets --------------------------------------------------------------
# Generate strong random values, e.g.: openssl rand -hex 32
DOWNLOAD_TOKEN_SECRET=change-me
CLEANUP_SECRET=change-me

# --- App configuration ------------------------------------------------------
# Host port the app is published on. Change this if something else on the
# VM (another nginx instance, another app, ...) already owns 3000.
APP_PORT=3000

# Absolute base URL used to build shareable links and QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Maximum accepted upload size, in bytes. Default below is 200 MB.
MAX_UPLOAD_SIZE_BYTES=209715200

# Maximum number of files allowed in a single drop.
MAX_FILES_PER_DROP=10

# Files at or over this size get their expiration capped to
# LARGE_FILE_MAX_EXPIRATION regardless of what's selected. Only has any
# effect once MAX_UPLOAD_SIZE_BYTES above is raised past this — at the
# 200 MB default, no upload can reach 1 GB in the first place. See
# README "How it works". Default below is 1 GB.
LARGE_FILE_THRESHOLD_BYTES=1073741824

# The expiration large files get capped to. Must be one of: 1h, 6h, 24h, 3d, 7d.
LARGE_FILE_MAX_EXPIRATION=24h

# --- Peer-to-peer transfers (optional) ---------------------------------
# The P2P mode works without any of this configured — browsers try a
# direct connection first, using only the public STUN server baked into
# the app. These are only needed to also run your own TURN relay as a
# fallback for restrictive NATs/firewalls where a direct connection isn't
# possible. Leave them blank to skip TURN entirely.
#
# To enable the bundled coturn service, set TURN_SECRET and
# TURN_EXTERNAL_IP below, then start compose with the p2p-turn profile:
#   docker compose --profile p2p-turn --env-file .env.docker up -d
# See README "Peer-to-peer transfers" for details.

# Shared secret coturn and the app both use to generate/verify short-lived
# TURN credentials. Generate with: openssl rand -hex 32
TURN_SECRET=

# Public IP of this VM — coturn advertises this to browsers so they know
# where to reach the relay. Required if TURN_SECRET is set.
TURN_EXTERNAL_IP=

# Port coturn listens on. Only change this if 3478 is already taken.
TURN_PORT=3478

# UDP port range coturn uses to actually relay media once a TURN
# allocation is made. Must be opened in any firewall/security group in
# front of this VM if you enable TURN.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# Realm string coturn reports to clients. Cosmetic — any value works.
TURN_REALM=filedrop
