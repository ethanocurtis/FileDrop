# Copy this file to .env.docker, then run compose with:
#   docker compose --env-file .env.docker up -d --build
# (a distinct file/flag on purpose, so it never collides with the plain
# .env you'd use for `npm run dev` in the same checkout.)
#
# This is a DIFFERENT set of variables than .env.example — that one is for
# running the app directly; this one only supplies the values
# docker-compose.yml substitutes into the containers it builds (which set
# DATABASE_URL/S3_* themselves, wired to the `postgres`/`minio` service
# names — see docker-compose.yml).

# --- Postgres (used by the postgres container + assembled into DATABASE_URL) ---
POSTGRES_USER=filedrop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=filedrop

# --- MinIO (used by the minio container + assembled into S3_* for the app) ---
MINIO_ROOT_USER=filedrop
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# --- Secrets --------------------------------------------------------------
# Generate strong random values, e.g.: openssl rand -hex 32
DOWNLOAD_TOKEN_SECRET=change-me
CLEANUP_SECRET=change-me

# --- App configuration ------------------------------------------------------
# Absolute base URL used to build shareable links and QR codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Maximum accepted upload size, in bytes. Default below is 200 MB.
MAX_UPLOAD_SIZE_BYTES=209715200

# Maximum number of files allowed in a single drop.
MAX_FILES_PER_DROP=10
