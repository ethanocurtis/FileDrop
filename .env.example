# Copy this file to .env and fill in real values before running the app.

# PostgreSQL connection string (see README for local setup instructions).
DATABASE_URL="postgresql://filedrop:filedrop@localhost:5432/filedrop?schema=public"

# --- S3-compatible object storage -------------------------------------------
# Works with AWS S3, MinIO, Cloudflare R2, Backblaze B2, DigitalOcean Spaces...
# See README "Object storage configuration" for provider-specific notes.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="filedrop"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
# Set to "true" for MinIO / most non-AWS providers. Set to "false" for AWS S3.
S3_FORCE_PATH_STYLE="true"

# --- Secrets -----------------------------------------------------------------
# Generate strong random values in production, e.g.: openssl rand -hex 32

# Signs short-lived, single-use tokens issued after a correct password check
# on a password-protected drop.
DOWNLOAD_TOKEN_SECRET="change-me"

# Bearer token required by POST /api/cleanup so the expiry sweep can't be
# triggered by anyone who finds the URL.
CLEANUP_SECRET="change-me"

# --- App configuration ---------------------------------------------------------
# Absolute base URL used to build shareable links and QR codes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Maximum accepted upload size, in bytes. Default below is 200 MB.
MAX_UPLOAD_SIZE_BYTES="209715200"

# Maximum number of files allowed in a single drop.
MAX_FILES_PER_DROP="10"

# Files at or over this size get their expiration capped to
# LARGE_FILE_MAX_EXPIRATION regardless of what's selected, since a large
# file costs more to keep around longer. Only has any effect once
# MAX_UPLOAD_SIZE_BYTES above is raised past this — at the 200 MB
# default, no upload can reach 1 GB in the first place. See README
# "How it works". Default below is 1 GB.
LARGE_FILE_THRESHOLD_BYTES="1073741824"

# The expiration large files get capped to. Must be one of: 1h, 6h, 24h, 3d, 7d.
LARGE_FILE_MAX_EXPIRATION="24h"

# --- Admin uploads (optional) -------------------------------------------
# Not required — the app works fully without it. When set, visiting /admin
# and entering this password unlocks a "Never expire (Admin)" option on
# the upload form. There's no username or account system — this is a
# single shared password, so treat it like any other credential and only
# share it with people you'd trust with an unlimited-lifetime upload. At
# least 8 characters. Leave blank/unset to disable admin login entirely.
# See README "Admin uploads".
ADMIN_PASSWORD=

# --- Peer-to-peer transfers (optional) ---------------------------------
# Not required — P2P works without any of this, using only a public STUN
# server. These enable a TURN relay as a fallback for networks where two
# browsers can't connect directly. See README "Peer-to-peer transfers".
# Leave both blank/unset to skip TURN entirely.

# Shared secret a coturn instance and this app both use to generate/verify
# short-lived TURN credentials. Generate with: openssl rand -hex 32
TURN_SECRET=

# Public IP of your coturn instance.
TURN_EXTERNAL_IP=

# Port coturn listens on. Only change this if 3478 is already taken.
TURN_PORT="3478"
